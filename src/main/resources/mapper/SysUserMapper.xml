<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.d0dd.wms.mapper.SysUserMapper">

    <resultMap id="SysUserResult" type="com.d0dd.wms.entity.SysUser">
        <id property="userId" column="user_id"/>
        <result property="familyName" column="family_name"/>
        <result property="givenName" column="given_name"/>
        <result property="nickName" column="nick_name"/>
        <result property="userType" column="user_type"/>
        <result property="email" column="email"/>
        <result property="phonenumber" column="phonenumber"/>
        <result property="sex" column="sex"/>
        <result property="avatar" column="avatar"/>
        <result property="password" column="password"/>
        <result property="status" column="status"/>
        <result property="delFlag" column="del_flag"/>
        <result property="loginIp" column="login_ip"/>
        <result property="loginDate" column="login_date"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectSysUserVo">
        select user_id, family_name, given_name, nick_name, user_type, email, phonenumber, sex, avatar, password, status, del_flag, login_ip, login_date, create_by, create_time, update_by, update_time, remark
        from sys_user
    </sql>

    <select id="selectList" parameterType="com.d0dd.wms.entity.SysUser" resultMap="SysUserResult">
        <include refid="selectSysUserVo"/>
        <where>
            <if test="givenName != null and givenName != ''">
                AND given_name like concat('%', #{givenName}, '%')
            </if>
            <if test="phonenumber != null and phonenumber != ''">
                AND phonenumber like concat('%', #{phonenumber}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </select>

    <select id="selectListByDto" parameterType="com.d0dd.wms.dto.SysUserQueryDto" resultMap="SysUserResult">
        <include refid="selectSysUserVo"/>
        <where>
            <if test="userName != null and userName != ''">
                AND (given_name like concat('%', #{userName}, '%') OR nick_name like concat('%', #{userName}, '%'))
            </if>
            <if test="phonenumber != null and phonenumber != ''">
                AND phonenumber like concat('%', #{phonenumber}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </select>

    <select id="selectById" parameterType="Long" resultMap="SysUserResult">
        <include refid="selectSysUserVo"/>
        where user_id = #{userId}
    </select>
    
    <select id="selectByUserName" parameterType="String" resultMap="SysUserResult">
        <include refid="selectSysUserVo"/>
        where nick_name = #{userName}
           or email = #{userName}
           or phonenumber = #{userName}
    </select>

    <insert id="insert" parameterType="com.d0dd.wms.entity.SysUser" useGeneratedKeys="true" keyProperty="userId">
        insert into sys_user(
            <if test="familyName != null">family_name,</if>
            <if test="givenName != null">given_name,</if>
            <if test="nickName != null">nick_name,</if>
            <if test="userType != null">user_type,</if>
            <if test="email != null">email,</if>
            <if test="phonenumber != null">phonenumber,</if>
            <if test="sex != null">sex,</if>
            <if test="avatar != null">avatar,</if>
            <if test="password != null">password,</if>
            <if test="status != null">status,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="remark != null">remark,</if>
            create_time
        )values(
            <if test="familyName != null">#{familyName},</if>
            <if test="givenName != null">#{givenName},</if>
            <if test="nickName != null">#{nickName},</if>
            <if test="userType != null">#{userType},</if>
            <if test="email != null">#{email},</if>
            <if test="phonenumber != null">#{phonenumber},</if>
            <if test="sex != null">#{sex},</if>
            <if test="avatar != null">#{avatar},</if>
            <if test="password != null">#{password},</if>
            <if test="status != null">#{status},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="remark != null">#{remark},</if>
            NOW()
        )
    </insert>

    <update id="update" parameterType="com.d0dd.wms.entity.SysUser">
        update sys_user
        <set>
            <if test="familyName != null">family_name = #{familyName},</if>
            <if test="givenName != null">given_name = #{givenName},</if>
            <if test="nickName != null">nick_name = #{nickName},</if>
            <if test="email != null">email = #{email},</if>
            <if test="phonenumber != null">phonenumber = #{phonenumber},</if>
            <if test="sex != null">sex = #{sex},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="password != null">password = #{password},</if>
            <if test="status != null">status = #{status},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="loginIp != null">login_ip = #{loginIp},</if>
            <if test="loginDate != null">login_date = #{loginDate},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = NOW()
        </set>
        where user_id = #{userId}
    </update>

    <delete id="deleteById" parameterType="Long">
        delete from sys_user where user_id = #{userId}
    </delete>
</mapper>
