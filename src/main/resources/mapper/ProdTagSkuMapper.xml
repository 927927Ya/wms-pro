<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.d0dd.wms.mapper.ProdTagSkuMapper">

    <resultMap id="ProdTagSkuResult" type="com.d0dd.wms.entity.ProdTagSku">
        <id property="id" column="id"/>
        <result property="tagId" column="tag_id"/>
        <result property="skuId" column="sku_id"/>
    </resultMap>

    <insert id="insert" parameterType="com.d0dd.wms.entity.ProdTagSku">
        insert into prod_tag_sku(tag_id, sku_id) values(#{tagId}, #{skuId})
    </insert>

    <delete id="deleteBySkuId" parameterType="Long">
        delete from prod_tag_sku where sku_id = #{skuId}
    </delete>

    <delete id="deleteByTagId" parameterType="Long">
        delete from prod_tag_sku where tag_id = #{tagId}
    </delete>

    <select id="selectTagIdsBySkuId" parameterType="Long" resultType="Long">
        select tag_id from prod_tag_sku where sku_id = #{skuId}
    </select>

    <select id="selectSkuIdsByTagId" parameterType="Long" resultType="Long">
        select sku_id from prod_tag_sku where tag_id = #{tagId}
    </select>
    
    <insert id="batchInsert" parameterType="java.util.List">
        insert into prod_tag_sku(id, tag_id, sku_id) values
        <foreach collection="list" item="item" separator=",">
            (#{item.id}, #{item.tagId}, #{item.skuId})
        </foreach>
    </insert>

</mapper>
