<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.d0dd.wms.mapper.OutboundMapper">

    <resultMap id="OutboundResult" type="com.d0dd.wms.entity.Outbound">
        <id property="id" column="id"/>
        <result property="warehouseId" column="warehouse_id"/>
        <result property="outboundType" column="outbound_type"/>
        <result property="outboundStatus" column="outbound_status"/>
        <result property="customerId" column="customer_id"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="outboundDate" column="outbound_date"/>
        <result property="remark" column="remark"/>
        <result property="warehouseName" column="warehouse_name"/>
        <result property="customerName" column="customer_name"/>
    </resultMap>

    <select id="selectList" parameterType="com.d0dd.wms.dto.OutboundOrderQueryDto" resultMap="OutboundResult">
        select o.*,
               w.warehouse_name,
               c.name as customer_name
        from outbound o
        left join warehouse w on o.warehouse_id = w.id
        left join customer c on o.customer_id = c.id
        <where>
            <if test="id != null">
                AND o.id = #{id}
            </if>
            <if test="warehouseId != null">
                AND o.warehouse_id = #{warehouseId}
            </if>
            <if test="outboundType != null and outboundType != ''">
                AND o.outbound_type = #{outboundType}
            </if>
            <if test="outboundStatus != null and outboundStatus != ''">
                AND o.outbound_status = #{outboundStatus}
            </if>
            <if test="customerId != null">
                AND o.customer_id = #{customerId}
            </if>
            <if test="outboundDate != null">
                AND o.outbound_date = #{outboundDate}
            </if>
            <if test="startTime != null and startTime != ''">
                AND o.create_time &gt;= #{startTime}
            </if>
            <if test="endTime != null and endTime != ''">
                AND o.create_time &lt;= #{endTime}
            </if>
        </where>
        order by o.create_time desc
    </select>

    <select id="countByStatus" resultType="int">
        select count(*) from outbound
        where outbound_status in
        <foreach item="status" collection="list" open="(" separator="," close=")">
            #{status}
        </foreach>
    </select>

    <select id="selectById" parameterType="Long" resultMap="OutboundResult">
        select o.*,
               w.warehouse_name,
               c.name as customer_name
        from outbound o
        left join warehouse w on o.warehouse_id = w.id
        left join customer c on o.customer_id = c.id
        where o.id = #{id}
    </select>

    <insert id="insert" parameterType="com.d0dd.wms.entity.Outbound" useGeneratedKeys="true" keyProperty="id">
        insert into outbound
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="warehouseId != null">warehouse_id,</if>
            <if test="outboundType != null">outbound_type,</if>
            <if test="outboundStatus != null">outbound_status,</if>
            <if test="customerId != null">customer_id,</if>
            <if test="createBy != null">create_by,</if>
            <if test="outboundDate != null">outbound_date,</if>
            <if test="remark != null">remark,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="warehouseId != null">#{warehouseId},</if>
            <if test="outboundType != null">#{outboundType},</if>
            <if test="outboundStatus != null">#{outboundStatus},</if>
            <if test="customerId != null">#{customerId},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="outboundDate != null">#{outboundDate},</if>
            <if test="remark != null">#{remark},</if>
            NOW()
        </trim>
    </insert>

    <update id="update" parameterType="com.d0dd.wms.entity.Outbound">
        update outbound
        <set>
            <if test="warehouseId != null">warehouse_id = #{warehouseId},</if>
            <if test="outboundType != null">outbound_type = #{outboundType},</if>
            <if test="outboundStatus != null">outbound_status = #{outboundStatus},</if>
            <if test="customerId != null">customer_id = #{customerId},</if>
            <if test="outboundDate != null">outbound_date = #{outboundDate},</if>
            <if test="remark != null">remark = #{remark},</if>
        </set>
        where id = #{id}
    </update>

    <delete id="deleteById" parameterType="Long">
        delete from outbound where id = #{id}
    </delete>
</mapper>
