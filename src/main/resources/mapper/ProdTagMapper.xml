<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.d0dd.wms.mapper.ProdTagMapper">

    <resultMap id="ProdTagResult" type="com.d0dd.wms.entity.ProdTag">
        <id property="id" column="id"/>
        <result property="tagName" column="tag_name"/>
        <result property="productNames" column="product_names"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectProdTagVo">
        select id, tag_name, create_by, create_time, update_by, update_time
        from prod_tag
    </sql>

    <select id="selectList" parameterType="com.d0dd.wms.entity.ProdTag" resultMap="ProdTagResult">
        select
            t.id,
            t.tag_name,
            GROUP_CONCAT(DISTINCT CONCAT_WS(' ', s.prod_name_eng, s.prod_name_chn) SEPARATOR ',') as product_names,
            t.create_by,
            t.create_time,
            t.update_by,
            t.update_time
        from prod_tag t
        left join prod_tag_sku pts on t.id = pts.tag_id
        left join prod_sku s on pts.sku_id = s.id
        <where>
            <if test="tagName != null and tagName != ''">
                AND t.tag_name like concat('%', #{tagName}, '%')
            </if>
        </where>
        GROUP BY t.id, t.tag_name, t.create_by, t.create_time, t.update_by, t.update_time
        ORDER BY t.create_time DESC
    </select>

    <select id="selectById" parameterType="Long" resultMap="ProdTagResult">
        <include refid="selectProdTagVo"/>
        where id = #{id}
    </select>

    <insert id="insert" parameterType="com.d0dd.wms.entity.ProdTag" useGeneratedKeys="true" keyProperty="id">
        insert into prod_tag
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="tagName != null">tag_name,</if>
            <if test="createBy != null">create_by,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="tagName != null">#{tagName},</if>
            <if test="createBy != null">#{createBy},</if>
            NOW()
        </trim>
    </insert>

    <update id="update" parameterType="com.d0dd.wms.entity.ProdTag">
        update prod_tag
        <set>
            <if test="tagName != null">tag_name = #{tagName},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = NOW()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteById" parameterType="Long">
        delete from prod_tag where id = #{id}
    </delete>
</mapper>
